{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nexus-med-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-med-practice",
      "database_id": "00000000000000000000000000000000",
      "migrations_dir": "../../prisma/cloudflare-migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "STUDY_FILES", "bucket_name": "nexus-med-study-files" }
  ]
}
