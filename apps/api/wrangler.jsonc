{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nexus-med-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-med-practice",
      "database_id": "02ea089b-9bdc-4ee6-b0d1-f6cf8731ee8c",
      "migrations_dir": "../../prisma/cloudflare-migrations"
    },
    {
      "binding": "DEMO_DB",
      "database_name": "nexus-med-demo",
      "database_id": "be80713a-a400-4204-99c5-39ad238f54bf",
      "migrations_dir": "../../prisma/cloudflare-migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "STUDY_FILES", "bucket_name": "nexus-med-study-files" }
  ]
}
