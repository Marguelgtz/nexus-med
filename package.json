{
  "name": "nexus-med",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus Med — plataforma de gestión de consultoría médica para un cirujano general (MVP local)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "node scripts/db-reset.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prisma": "^7.10.1",
    "tsx": "^4.20.0",
    "wrangler": "^4.160.1"
  },
  "overrides": {
    "@opennextjs/aws": {
      "@node-minify/core": {
        "glob": {
          ".": "10.5.0",
          "minimatch": "11.0.8"
        }
      }
    },
    "@opennextjs/cloudflare": {
      "glob": "14.0.5"
    }
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "workerd@1.20261110.1": true
  }
}
