# Local configuration — names only, no secrets.
#
# The default local setup needs no .env file: scripts resolve the database
# path at <repo root>/.local/data/medical.db automatically.
#
# Override examples (all optional):
# DATABASE_URL=file:/absolute/path/to/medical.db
# API_PORT=4000
# WEB_PORT=3000
# API_INTERNAL_URL=http://127.0.0.1:4000
