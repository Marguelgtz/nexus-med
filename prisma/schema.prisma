// Nexus Med — relational schema (local SQLite via Prisma ORM 7).
// Source of truth for the local data model. See docs/DATA_MODEL.md.

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

// The same canonical schema generates a Worker-compatible client for the
// Cloudflare D1 entry point. Local Node development keeps the default runtime.
generator worker {
  provider = "prisma-client"
  runtime  = "cloudflare"
  output   = "../apps/api/src/generated/prisma-worker"
}

datasource db {
  provider = "sqlite"
  // Prisma 7: the connection URL is not allowed in the schema. It is defined
  // in prisma.config.ts for the CLI and via the driver adapter at runtime.
}

// One person receiving care. The stable center of the clinical record.
model Patient {
  version Int @default(1)
  clinicId String @default("legacy-clinic")
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  id                 String  @id @default(uuid())
  fullName           String
  // Date-only value stored as YYYY-MM-DD to avoid timezone shifts.
  dateOfBirth        String?
  phone              String?
  email              String?
  appointmentEmailConsent          Boolean   @default(false)
  appointmentEmailConsentUpdatedAt  DateTime?
  // Practice-specific identifier (optional).
  externalIdentifier String?

  // Medical background — current ongoing context, free text in the prototype.
  // Blank means "not recorded", never a confirmed negative finding.
  medicalConditions  String?
  previousSurgeries  String?
  allergies          String?
  currentMedications String?

  // Archiving keeps the record and its clinical history; never hard delete.
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  encounters       Encounter[]
  appointments     Appointment[]
  studyRequests    StudyRequest[]
  medicalDocuments MedicalDocument[]
  studyReceipts    StudyReceipt[]

  @@index([fullName])
  @@map("patients")
  @@index([clinicId])
}

// One consultation belonging to exactly one patient.
// Note content is attached to the encounter; it is never rewritten when the
// patient's demographics or medical background change.
model Encounter {
  authorId String?
  author User? @relation("EncounterAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  lastEditedById String?
  lastEditedBy User? @relation("EncounterEditor", fields: [lastEditedById], references: [id], onDelete: Restrict)
  version Int @default(1)
  clinicId String @default("legacy-clinic")
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  // Server-generated id (uuid); the client never supplies encounter ids.
  id                      String   @id @default(uuid())
  patientId               String
  patient                 Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  // When the consultation happened. Distinct from createdAt/updatedAt.
  occurredAt              DateTime
  // Fixed list (validated at the API): consulta, procedimiento,
  // visita_domicilio, urgencia. What actually HAPPENED (D-024); default
  // `consulta` — pre-expansion records are consultations and migrate
  // without changing meaning.
  type                    String   @default("consulta")
  reason                  String?
  historyOfPresentIllness String?
  relevantHistory         String?
  physicalExamination     String?
  assessment              String?
  plan                    String?
  followUp                String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Appointments completed by linking to this encounter (at most one per
  // appointment; the link is the only relationship — the note is never
  // copied into the appointment).
  linkedAppointments Appointment[]
  // Study requests ordered during this consultation (UI_SPEC §7.3).
  studyRequests      StudyRequest[]
  medicalDocuments   MedicalDocument[]
  studyReceipts      StudyReceipt[]

  @@index([patientId, occurredAt(sort: Desc)])
  @@map("encounters")
  @@index([clinicId])
}

// One scheduled visit belonging to exactly one patient (UI_SPEC §7.1).
// `startAt` is an instant like `occurredAt`; the UI renders it in the
// practice timezone. Status transitions are explicit and one-directional
// (scheduled → completed | cancelled; cancelled → scheduled via
// reschedule); `completed` is final.
model Appointment {
  doctorId String?
  doctor User? @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  version Int @default(1)
  clinicId String @default("legacy-clinic")
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  id                    String     @id @default(uuid())
  patientId             String
  patient               Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  // When the visit is (or was) planned to start.
  startAt               DateTime
  // Planned duration in minutes (5–480, validated at the API boundary).
  durationMinutes       Int
  // Fixed list (validated at the API): consulta, procedimiento,
  // visita_domicilio, urgencia. What was PLANNED — distinct from the
  // actual encounter type.
  type                  String
  // scheduled, completed, cancelled (validated at the API).
  status                String     @default("scheduled")
  // Set on completion; the doctor's record of how long it actually took.
  arrivedAt             DateTime?
  attentionStartedAt    DateTime?
  actualDurationMinutes Int?
  completedAt           DateTime?
  linkedEncounterId     String?    @unique
  linkedEncounter       Encounter? @relation(fields: [linkedEncounterId], references: [id], onDelete: SetNull)
  emailOutbox           EmailOutbox[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([clinicId, doctorId, startAt])
  @@index([startAt])
  @@index([patientId, startAt])
  @@map("appointments")
  @@index([clinicId])
}

// One specific study request belonging to a patient. A request may be made
// outside a consultation; when an encounter is associated, it must belong to
// the same patient (validated by Hono). Existing encounter links are kept.
// No edit, no delete (no permanent-delete rule).
model StudyRequest {
  orderedById String?
  orderedBy User? @relation("StudyOrderer", fields: [orderedById], references: [id], onDelete: Restrict)
  reviewedById String?
  reviewedBy User? @relation("StudyReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  clinicId String @default("legacy-clinic")
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  // Optional consultation context; immutable after request creation.
  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  // Fixed list (validated at the API): laboratorio, imagenologia, rayos_x,
  // ecg, ecografia, otro.
  category    String
  // The specific study, in the doctor's words (e.g. "Biometría hemática").
  name        String
  // Optional doctor-authored detail about the requested study.
  description String?
  // ordered, completed, reviewed (validated at the API); reviewed is final.
  status      String    @default("ordered")
  // The doctor's observation about the result — verbatim, never an
  // interpretation (≤ 1,000 chars, validated at the API).
  resultNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  receipts    StudyReceipt[]

  @@index([patientId, status])
  @@index([encounterId])
  @@map("study_requests")
  @@index([clinicId])
}

// Doctor-authored structured documents; body is report narrative or general
// prescription instructions. Files and generated clinical content are out of scope.
model MedicalDocument {
  authorId String?
  author User? @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  lastEditedById String?
  lastEditedBy User? @relation("DocumentEditor", fields: [lastEditedById], references: [id], onDelete: Restrict)
  version Int @default(1)
  clinicId String @default("legacy-clinic")
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  id          String             @id @default(uuid())
  patientId   String
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounterId String?
  encounter   Encounter?         @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  kind        String
  title       String?
  body        String?
  lines       PrescriptionLine[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([patientId, createdAt(sort: Desc)])
  @@index([encounterId])
  @@map("medical_documents")
  @@index([clinicId])
}

model PrescriptionLine {
  id           String          @id @default(uuid())
  documentId   String
  document     MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position     Int
  medication   String
  dose         String?
  route        String?
  frequency    String?
  duration     String?
  instructions String?

  @@index([documentId, position])
  @@map("prescription_lines")
}

// Received evidence is distinct from a physician-authored study order.
model StudyReceipt {
  receivedById String?
  receivedBy User? @relation("StudyReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  reviewedById String?
  reviewedBy User? @relation("ReceiptReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  clinicId String @default("legacy-clinic")
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  id          String @id @default(uuid())
  patientId   String
  patient     Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  requestId   String?
  request     StudyRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  title       String
  studyDate   String?
  receiptNote String?
  receivedAt  DateTime @default(now())
  reviewedAt  DateTime?
  reviewNote  String?
  files       StudyReceiptFile[]

  @@index([patientId, receivedAt])
  @@index([reviewedAt, receivedAt])
  @@map("study_receipts")
  @@index([clinicId])
}
model StudyReceiptFile {
  id          String @id @default(uuid())
  receiptId   String
  receipt     StudyReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  storageKey  String @unique
  name        String
  mimeType    String
  size        Int

  @@index([receiptId])
  @@map("study_receipt_files")
}

// Better Auth identity. Role is server-owned and scoped to this single
// practice; multi-practice support requires explicit practice foreign keys
// on clinical data rather than inferring tenancy from this role field.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("pending")
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships          ClinicMembership[]
  authoredEncounters   Encounter[] @relation("EncounterAuthor")
  editedEncounters     Encounter[] @relation("EncounterEditor")
  authoredDocuments    MedicalDocument[] @relation("DocumentAuthor")
  editedDocuments      MedicalDocument[] @relation("DocumentEditor")
  assignedAppointments Appointment[] @relation("AppointmentDoctor")
  orderedStudies       StudyRequest[] @relation("StudyOrderer")
  reviewedStudies      StudyRequest[] @relation("StudyReviewer")
  receivedStudies      StudyReceipt[] @relation("StudyReceiver")
  reviewedReceipts     StudyReceipt[] @relation("ReceiptReviewer")
  sessions             Session[]
  accounts             Account[]
  createdInvitations   Invitation[]    @relation("InvitationCreator")
  acceptedInvitations  Invitation[]    @relation("InvitationAcceptor")
  securityEvents       SecurityEvent[] @relation("SecurityEventActor")

  @@index([role, disabledAt])
  @@map("auth_users")
}

model Session {
  activeClinicId String?
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // A demo-only preference stored per session, never on the shared user.
  demoView  String   @default("doctor")

  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@unique([providerId, accountId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

model Invitation {
  clinicId String @default("legacy-clinic")
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  id             String    @id @default(uuid())
  email          String
  role           String    @default("secretary")
  tokenHash      String    @unique
  expiresAt      DateTime
  createdById    String
  createdBy      User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedUserId String?
  acceptedUser   User?     @relation("InvitationAcceptor", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([email, expiresAt, revokedAt, acceptedAt])
  @@map("auth_invitations")
  @@index([clinicId])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation("SecurityEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  event     String
  targetId  String?
  outcome   String
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([event, createdAt])
  @@map("security_events")
}

model AuthRateLimit {
  key        String   @id
  count      Int      @default(0)
  windowFrom DateTime
  updatedAt  DateTime @updatedAt

  @@index([windowFrom])
  @@map("auth_rate_limits")
}

// Durable delivery queue. Auth message payloads are encrypted with the auth
// secret because they contain single-use verification/reset URLs.
model EmailOutbox {
  id             String    @id @default(uuid())
  kind           String
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  appointmentVersion String?
  appointmentEvent String?
  recipient      String
  subject        String
  encryptedBody  String
  idempotencyKey String    @unique
  status         String    @default("queued")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  leaseExpiresAt DateTime?
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([appointmentId, createdAt])
  @@map("email_outbox")
}


model Clinic {
  id String @id @default(uuid())
  name String
  timezone String @default("America/Mexico_City")
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships ClinicMembership[]
  patients Patient[]
  encounters Encounter[]
  appointments Appointment[]
  studyRequests StudyRequest[]
  medicalDocuments MedicalDocument[]
  studyReceipts StudyReceipt[]
  invitations Invitation[]
  @@map("clinics")
}

model ClinicMembership {
  id String @id @default(uuid())
  clinicId String
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role String
  isAdmin Boolean @default(false)
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([clinicId, userId])
  @@index([userId, status])
  @@index([clinicId, role, status])
  @@map("clinic_memberships")
}

// Empty outside an atomic batch; CHECK(valid=1) in the migration aborts stale writes.
model AtomicWriteGuard {
  id String @id
  valid Int
  @@map("atomic_write_guards")
}
